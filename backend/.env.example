# Copy to .env and set an appropriate local PostgreSQL URL.
DATABASE_URL=postgresql+psycopg://careercoach:change-me@localhost:5432/careercoach
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
APP_ENV=development
# Optional AI provider credentials. Leave unset to disable provider clients.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL_ID=gemini-3.8-flash
GROQ_MODEL_ID=openai/gpt-oss-120b
LLM_PROVIDER_TIMEOUT_SECONDS=30
LLM_ROADMAP_MAX_OUTPUT_TOKENS=4096
# Generate a unique secret with at least 32 random bytes and keep it stable across all backend instances.
RATE_LIMIT_HMAC_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
# Set these from the Upstash Redis REST credentials. Never commit actual credentials.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token
# Generate a separate random 32-byte key and encode it with standard Base64.
REFRESH_RECOVERY_ENCRYPTION_KEY_ID=primary
REFRESH_RECOVERY_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Optional previous key, retained only while recovery records using it may remain.
# REFRESH_RECOVERY_PREVIOUS_ENCRYPTION_KEY_ID=previous
# REFRESH_RECOVERY_PREVIOUS_ENCRYPTION_KEY=replace-with-previous-base64-encoded-32-byte-key
